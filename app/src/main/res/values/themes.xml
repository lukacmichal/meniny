<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Bez opt-outu Android 15+ kresli appku s targetSdk 35 pod stavovu listu
      a navigaciu (nadpis pod hodinami, paticka pod gestom). docs/shared-standard.md 2.6.
    -->
    <style name="Theme.Meniny" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!--
      Riadok widgetu = ciara + text. Ciara je nad textom, takze prva zaroven
      oddeluje dnesok od zoznamu dalsich dni. Cely blok sa skryva naraz, ked
      sa riadok do widgetu nezmesti.
    -->
    <!--
      Styly generovaneho zoznamu (WidgetRiadokBox, WidgetRiadok,
      WidgetOslavenec…) su od 30. 8. 2026 prec: widget uz nema pevne riadky
      v layoute, plni ho `DniService` do `ListView` a riadok ma vlastny layout
      `item_widget_den.xml`.
    -->
</resources>
