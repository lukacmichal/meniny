    <string name="n_zaloha_popis">Uloží sledovaných oslávencov, čas pripomienky a adresu NAS-u do jedného súboru. Kalendár mien je v appke a po preinštalovaní sa vráti sám — oslávenci nie, tí sú jediné, čo si tu zadávaš ručne. Heslá v súbore nie sú. Import zoznam nahradí, nie doplní.</string>
    <string name="n_export">Exportovať…</string>
    <string name="n_import">Importovať…</string>
    <string name="n_export_ok">Uložené — %1$d oslávencov.</string>
    <string name="n_import_ok">Naimportované — %1$d oslávencov. Nezabudni Uložiť, ak si dolu niečo menil.</string>
    <string name="n_zaloha_chyba">Nepodarilo sa: %1$s</string>

    <string name="n_nas_popis">Odtiaľto si appka sťahuje vlastné aktualizácie. Je to zdieľaný priečinok na NAS-e (SMB), nie internet — mimo domu sa kontrola ticho preskočí. Prázdne pole znamená „použi to, s čím bola appka zbuildovaná“.</string>
    <string name="n_host_popis">IP alebo meno NAS-u v domácej sieti, napr. nas.local.</string>
    <string name="n_share_popis">Zdieľaný priečinok na NAS-e, v ktorom sú appky. U nás Android.</string>
    <string name="n_path_popis">Podpriečinok tejto appky v tom share-i. U nás Meniny.</string>
    <string name="n_file_popis">Názov APK súboru. Meno je pevné a pri každom vydaní sa prepíše; verziu appka číta z APK, nie z názvu.</string>
    <string name="n_user_popis">Meno SMB účtu, ktorý má na NAS-e prístup k tomu priečinku.</string>
    <string name="n_pass_popis">Heslo k tomu SMB účtu. Leží v šifrovanom úložisku telefónu a do zálohy sa nedostane.</string>

