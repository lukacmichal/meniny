<?xml version="1.0" encoding="utf-8"?>
<!--
  Podklad dnesneho dna v zozname. Pruh vlavo + jemne zafarbenie: v dlhom
  zozname dni musi byt dnesok vidiet bez citania datumov.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dnes_pozadie" />
        </shape>
    </item>
    <item android:width="4dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/zvyraznenie" />
        </shape>
    </item>
</layer-list>
