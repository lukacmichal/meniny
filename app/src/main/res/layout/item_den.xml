<?xml version="1.0" encoding="utf-8"?>
<!--
  Riadok jedneho dna.

  Od 27. 8. 2026 je riadok VODOROVNY: vlavo datum a mena, VPRAVO oslavenec.
  Predtym bol oslavenec dalsim riadkom pod menami a v zozname 120 dni po sebe
  splynul s ostatnymi popiskami — hoci je to jedina vec, kvoli ktorej sa clovek
  do zoznamu pozera. Na pravom okraji sa da prejst palcom zhora nadol a hned
  vidiet, kde niekto slavi.

  Pravy stlpec ma pevny `maxWidth`: bez neho by dlhe meno ubralo sirku menam
  vlavo a kazdy den by mal iny zlom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/riadok"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/datum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textColor="@color/text_vedlajsi" />

        <TextView
            android:id="@+id/mena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_hlavny" />

        <TextView
            android:id="@+id/popis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/text_vedlajsi" />

        <TextView
            android:id="@+id/sviatky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="13sp"
            android:visibility="gone"
            android:textColor="@color/sviatok" />
    </LinearLayout>

    <!--
      Sledovany clovek, ktory v ten den slavi. Vlastnou farbou a na pravom
      okraji — prave kvoli nemu je ten riadok zaujimavy.
    -->
    <TextView
        android:id="@+id/oslavenci"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:maxWidth="150dp"
        android:gravity="end"
        android:textAlignment="viewEnd"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:textColor="@color/oslava" />
</LinearLayout>
