<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget na plochu: dnesok velkym pismom a dalsie dni pod nim.

  Data su offline (asset v APK), takze widget funguje aj bez signalu — presne
  preto sa kalendar nesahuje zo siete.

  **Zoznam dalsich dni sa roluje PRSTOM** (30. 8. 2026). Do vtedy mal pevnych
  dvanast riadkov a posledny sa na ploche orezaval napoly; sipky ↑ ↓ boli len
  nahrada. Zadanie znelo inak: „ked prstom kliknem do toho widgetu, tak mozem
  s nim hybat hore a dole". Zoznam je preto skutocna `ListView` plnena cez
  `RemoteViewsService` ([DniService]) a layout uz nie je generovany skriptom.

  Dnesok ostava NAD zoznamom a neroluje sa s nim: widget je predovsetkym o tom,
  kto ma meniny dnes, a to nema odrolovat prec.

  **Dnesok je JEDEN riadok** (18. 10. 2026): "Dnes 18. oktobra  Lukas" na
  podfarbenom pasiku s fialovym pruhom vlavo — ako dnesny riadok v appke.
  Predtym bol hore sivy riadok s datumom a meno az pod nim. Farby pasika
  a pruhu nastavuje provider (podla rezimu appky), preto pruh nie je drawable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@color/widget_pozadie">

    <!--
      Dnesok: pruh, "Dnes 18. oktobra" + mena v jednom texte, pod nimi vpravo
      oslavenec. Pruh je ImageView, nie View — holy View RemoteViews nepovolia.

      Oslavenec je v DRUHOM riadku pasika, nie vedla mien ako v zozname: vedla
      by na beznom widgete zobral polovicu sirky a datum s menom by sa lamali
      aj uprostred slova ("18. o / kto…") — overene na snimke 18. 10. 2026.
    -->
    <LinearLayout
        android:id="@+id/w_dnes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:background="@color/dnes_pozadie">

        <ImageView
            android:id="@+id/w_dnes_pruh"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/zvyraznenie"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/w_dnes_mena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:maxLines="4"
                android:ellipsize="end"
                android:textColor="@color/zvyraznenie" />

            <TextView
                android:id="@+id/w_dnes_oslavenci"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textAlignment="viewEnd"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="gone"
                android:textColor="@color/oslava" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_prazdno"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="@color/text_vedlajsi" />

    <ListView
        android:id="@+id/w_dni"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />
</LinearLayout>
